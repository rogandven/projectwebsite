---
import "../assets/app.css";
import DUNavbar from "../components/ui/DUNavbar.astro";
import DUFooter from "../components/ui/DUFooter.astro";
import DATA from "../data/DATA";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{DATA.projectName}</title>
	</head>
	<body>
		<DUNavbar links={DATA.links} projectName={DATA.projectName} ProjectLogo={DATA.defaultIcon} />
		<slot />
		<DUFooter projectName={DATA.projectName} Logo={DATA.defaultIcon} socials={DATA.socials} />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

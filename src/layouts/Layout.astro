---
import "../assets/app.css";
import DUNavbar from "../components/ui/DUNavbar.astro";
import DUFooter from "../components/ui/DUFooter.astro";
import DATA from "../data/DATA";
import LinkInfo from "../classes/LinkInfo";
import { DEFAULT_PAGE } from "../constants/URL.constants";

interface Props {
  navbarLinks: LinkInfo[],
}

const { 
	navbarLinks,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{DATA.projectName}</title>
	</head>
	<body style={"display: grid; min-height: 100dvh; grid-template-rows: auto 1fr auto"}>
		<header class="w-full">
			<DUNavbar defaultPage={DEFAULT_PAGE} links={navbarLinks} projectName={DATA.projectName} ProjectLogo={DATA.defaultIcon} />
		</header>
		<main class="w-full">
			<slot />
		</main>
		<footer class="w-full">
			<DUFooter projectName={DATA.projectName} Logo={DATA.defaultIcon} socials={DATA.socials} />
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

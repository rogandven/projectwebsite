---
import DUTitleSubtitle from "./DUTitleSubtitle.astro";

interface Props {
    buttonLogo?: Function | undefined,
    title: string,
    subtitle: string,
    buttonText: string,
    buttonDestination: string,
}

const { 
    buttonLogo = undefined,
    title, 
    subtitle,
    buttonText,
    buttonDestination,
} = Astro.props;

const ButtonLogo = buttonLogo;
---
<div
  class="hero"
  style="background-image: url(https://img.daisyui.com/images/stock/photo-1507358522600-9f71e620c44e.webp);"
>
  <div class="hero-overlay"></div>
  <div class="hero-content text-neutral-content text-center">
    <div class="max-w-md">
      <DUTitleSubtitle title={title} subtitle={subtitle} />
      <a href={buttonDestination}>
        <button class="btn btn-primary">
          <div class="flex flex-row items-center">
            {ButtonLogo && <ButtonLogo class="mr-1" width="17" height="17" />}
            <span>{buttonText}</span>
          </div>
        </button>
      </a>
    </div>
  </div>
</div>
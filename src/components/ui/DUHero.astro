---
import DUTitleSubtitle from "./DUTitleSubtitle.astro";

interface Props {
    buttonLogo?: Function | undefined,
    title: string,
    subtitle: string,
    buttonText: string,
    buttonDestination: string,
    imageSource: ImageMetadata,
}

const { 
    buttonLogo = undefined,
    title, 
    subtitle,
    buttonText,
    buttonDestination,
    imageSource,
} = Astro.props;

const ButtonLogo = buttonLogo;
const imageSourceCasted: ImageMetadata = imageSource;
---
<div
  class="hero w-full"
  style={`background-image: url(${imageSourceCasted.src});`}
>
  <div class="hero-overlay"></div>
  <div class="hero-content w-5/6 text-neutral-content text-center">
    <div class="w-full">
      <DUTitleSubtitle title={title} subtitle={subtitle} />
      <a href={buttonDestination}>
        <button class="btn btn-primary">
          <div class="flex flex-row items-center">
            {ButtonLogo && <ButtonLogo class="mr-1" width="17" height="17" />}
            <span>{buttonText}</span>
          </div>
        </button>
      </a>
    </div>
  </div>
</div>